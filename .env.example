# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_VERSION=v1

# Database Configuration
# Option 1: Local PostgreSQL (Development)
DATABASE_URL=postgresql://user:password@localhost:5432/english_learning_db
DIRECT_URL=postgresql://user:password@localhost:5432/english_learning_db

# Option 2: Supabase with Connection Pooling (Production)
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-[REGION].pooler.supabase.com:5432/postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-this

# Email Service (SendGrid/SMTP)
EMAIL_SERVICE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@englishlearning.com
SENDGRID_API_KEY=

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=english-learning-assets
AWS_CLOUDFRONT_URL=https://your-cdn.cloudfront.net

# Azure Blob Storage (Alternative to S3)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_STORAGE_CONTAINER=

# Azure Speech API
AZURE_SPEECH_KEY=your-azure-speech-api-key
AZURE_SPEECH_REGION=eastus

# SpeechSuper API (Alternative)
SPEECHSUPER_APP_KEY=
SPEECHSUPER_SECRET_KEY=

# Payment Gateways
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# TURN/STUN Servers (for WebRTC)
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=
STUN_SERVER_URL=stun:stun.l.google.com:19302

# SignalR Configuration
SIGNALR_HUB_PATH=/signalr

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=15m

# CORS
CORS_ORIGIN=http://localhost:3001,https://yourdomain.com

# Application URLs
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:3000

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,audio/mpeg,audio/wav,application/pdf

# Referral Configuration
REFERRAL_REWARD_AMOUNT=50
REFERRER_BONUS_AMOUNT=100

# Subscription Trial
DEFAULT_TRIAL_DAYS=7

# Admin Configuration
ADMIN_EMAIL=admin@englishlearning.com
ADMIN_PASSWORD=change-this-password

# Logging
LOG_LEVEL=info
